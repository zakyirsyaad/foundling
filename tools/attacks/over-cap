#!/usr/bin/env python3
import sys
from pathlib import Path

try:
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    from _sandbox import main

    code = main("over-cap")
except Exception as err:  # an uncaught exception exits 1, which reads as "attack succeeded"
    print(f"ERROR: over-cap: {err!r}", file=sys.stderr)
    code = 2
sys.exit(code)
