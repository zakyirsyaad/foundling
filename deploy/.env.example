# Copy to deploy/.env on the VPS and fill in. Never commit the filled file.
# The site's domain; Caddy serves api.<DOMAIN>.
DOMAIN=
# Superuser password of the postgres container; used only by the one-shot migrate service.
POSTGRES_PASSWORD=
# postgres://foundling_reader:<password>@postgres:5432/foundling ; migrate gives the role this password.
DATABASE_URL_READER=
# postgres://foundling_writer:<password>@postgres:5432/foundling ; migrate gives the role this password.
DATABASE_URL_WRITER=
# The one vault this stack indexes and serves.
ACTIVE_VAULT_ID=
# testnet or mainnet.
CHAIN=
# live, or rehearsal for a testnet vault whose prices are mocked.
OBS_SOURCE=
# Comma-separated https RPC URLs; empty uses FastNEAR's public nodes.
RPC_URLS=
# Comma-separated archival RPC URLs, also handed to fetch_proof.py as --rpc.
ARCHIVAL_RPC_URLS=
# Optional.
FASTNEAR_API_KEY=
# The website's exact origin, for CORS, e.g. https://foundling.xyz
WEB_ORIGIN=
# The commit that built ACTIVE_VAULT_ID's wasm_hash; the worker image builds foundling-verify from it.
VERIFIER_COMMIT=
# Optional. A second API key on the NEAR AI account whose key the vault holds sealed (never that key
# itself). With it the worker archives each decision's NEAR AI signature and attestation report in the
# proof bundle. Set it only when VERIFIER_COMMIT already reads `ai_signature`; an older verifier rejects
# the bundle.
NEARAI_ARCHIVE_KEY=
